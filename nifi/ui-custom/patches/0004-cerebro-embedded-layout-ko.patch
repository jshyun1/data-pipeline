+const SORTABLE: Array<[RegExp, string]> = [
+    [/^Name\s*([↑↓])?$/, '이름'],
+    [/^Provider\s*([↑↓])?$/, '제공자'],
+    [/^Description\s*([↑↓])?$/, '설명'],
