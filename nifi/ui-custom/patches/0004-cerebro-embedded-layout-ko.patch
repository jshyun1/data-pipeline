@@ -0,0 +1,296 @@
+/*
+ * Cerebro 맞춤 (Cerebro 저장소 nifi/ui-custom/patches 로 관리한다 - NiFi 원본 소스에는 없는 파일).
+ *
+ * 캔버스의 프로세스 그룹 · 프로세서 상자를 디자인 카드(CEREBRO_ETL_UI_DESIGN_20261008 etl-manage.html 의 .nifi-node-card)처럼 그린다.
+ * NiFi 매니저(process-group-manager · processor-manager)가 상자를 만들 때 아래 요소를 같이 만든다 - 모두 display="none" 이라
+ * NiFi 에 직접 들어오면 보이지 않고, Cerebro 안(html.cerebro-embedded)에서만 _cerebro-embedded.scss 가 보이게 · 배치한다.
+ *
+ *   머리띠   → 왼쪽 아이콘(디자인 툴바와 같은 그룹 · 톱니 모양) · 오른쪽 «프로세스 그룹»/«프로세서» 표시 · 아래 선
+ *   지표 표  → 이름 칸 바탕(디자인 th) · «5 min» 알약
+ *   상태줄   → 항목 양끝 맞춤 · 멈춤(빨강)/잘못됨(주황) 강조, 바닥줄 → 오른쪽 맞춤(cerebroLayoutGroupContents)
+ *
+ * 상자 크기(384×176 · 352×128)는 NiFi 그대로다 - 바꾸면 이미 그려 둔 흐름의 상자끼리 겹친다.
+ */
+import { isEmbeddedInCerebro } from './cerebro-embed';
+
+type CerebroBoxKind = 'group' | 'processor';
+
+const SVG_ICON_SCALE = 14 / 24; // 디자인 아이콘: 24 단위 viewBox 를 14px 로
+
+// 디자인 툴바(.toolbar-btn)의 아이콘과 같은 모양 - 그룹은 겹친 사각형 두 개, 프로세서는 톱니.
+const GEAR_PATH =
+    'M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 ' +
+    '1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06' +
+    'a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 ' +
+    '2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 ' +
+    '1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33' +
+    'l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 ' +
+    '2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z';
+
+const HEADER = {
+    group: { height: 32, tag: '프로세스 그룹' },
+    processor: { height: 30, tag: '프로세서' }
+};
+
+type CerebroProcessGroupType = 'JOB' | 'GROUPING' | 'EMPTY';
+
+const processGroupTypeCache = new Map<string, Promise<CerebroProcessGroupType>>();
+
+// 이름이 오른쪽 «프로세스 그룹»/«프로세서» 표시 · 아이콘과 겹치지 않게 줄이는 폭(Cerebro 안에서만).
+export function cerebroNameWidth(kind: CerebroBoxKind, nifiWidth: number): number {
+    if (!isEmbeddedInCerebro()) {
+        return nifiWidth;
+    }
+    return nifiWidth - (kind === 'group' ? 26 : 12);
+}
+
+function arrayLength(value: unknown): number {
+    return Array.isArray(value) ? value.length : 0;
+}
+
+function directProcessGroupContents(d: any): any {
+    return d?.contents ?? d?.component?.contents ?? d?.processGroupFlow?.flow ?? d?.flow;
+}
+
+function hasDirectProcessors(d: any): boolean {
+    const contents = directProcessGroupContents(d);
+    return arrayLength(contents?.processors) > 0;
+}
+
+function hasDirectChildGroups(d: any): boolean {
+    const contents = directProcessGroupContents(d);
+    return arrayLength(contents?.processGroups) > 0;
+}
+
+export function cerebroProcessGroupType(d: any): CerebroProcessGroupType {
+    if (hasDirectProcessors(d)) {
+        return 'JOB';
+    }
+    return hasDirectChildGroups(d) ? 'GROUPING' : 'EMPTY';
+}
+
+function processGroupId(d: any): string | undefined {
+    return d?.id ?? d?.component?.id ?? d?.processGroupFlow?.id;
+}
+
+function looksLikeProcessGroupId(value: unknown): value is string {
+    return (
+        typeof value === 'string' &&
+        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)
+    );
+}
+
+function firstProcessGroupIdInObject(value: unknown, depth = 0, visited = new Set<unknown>()): string | undefined {
+    if (looksLikeProcessGroupId(value)) {
+        return value;
+    }
+    if (!value || typeof value !== 'object' || depth > 4 || visited.has(value)) {
+        return undefined;
+    }
+    visited.add(value);
+    const entries = Object.entries(value as Record<string, unknown>);
+    for (const [key, entry] of entries) {
+        if (/^(id|groupId|processGroupId)$/i.test(key) && looksLikeProcessGroupId(entry)) {
+            return entry;
+        }
+    }
+    for (const [, entry] of entries) {
+        const found = firstProcessGroupIdInObject(entry, depth + 1, visited);
+        if (found) {
+            return found;
+        }
+    }
+    return undefined;
+}
+
+function cleanProcessGroupDomId(value: string | null | undefined): string | undefined {
+    const cleaned = value?.replace(/^(id-|component-|process-group-|pg-)/i, '');
+    return looksLikeProcessGroupId(cleaned) ? cleaned : undefined;
+}
+
+function processGroupSelectionId(processGroup: any, d: any): string | undefined {
+    return (
+        processGroupId(d) ??
+        firstProcessGroupIdInObject(d) ??
+        cleanProcessGroupDomId(processGroup.attr('data-id')) ??
+        cleanProcessGroupDomId(processGroup.attr('data-component-id')) ??
+        cleanProcessGroupDomId(processGroup.attr('id'))
+    );
+}
+
+async function fetchCerebroProcessGroupType(id: string): Promise<CerebroProcessGroupType> {
+    const response = await fetch(`/nifi-api/flow/process-groups/${encodeURIComponent(id)}`, {
+        credentials: 'same-origin',
+        cache: 'no-store'
+    });
+    if (!response.ok) {
+        throw new Error(`Failed to load process group ${id}: ${response.status}`);
+    }
+    const data = await response.json();
+    const contents = data?.processGroupFlow?.flow;
+    if (arrayLength(contents?.processors) > 0) {
+        return 'JOB';
+    }
+    return arrayLength(contents?.processGroups) > 0 ? 'GROUPING' : 'EMPTY';
+}
+
+function loadCerebroProcessGroupType(id: string): Promise<CerebroProcessGroupType> {
+    let cached = processGroupTypeCache.get(id);
+    if (!cached) {
+        cached = fetchCerebroProcessGroupType(id).catch((error) => {
+            processGroupTypeCache.delete(id);
+            throw error;
+        });
+        processGroupTypeCache.set(id, cached);
+    }
+    return cached;
+}
+
+/** 백엔드 트리와 같은 기준: 직계 프로세서가 있으면 JOB, 없고 하위 그룹이 있으면 GROUPING, 둘 다 없으면 EMPTY. */
+export function markCerebroProcessGroupType(processGroup: any, d: any): void {
+    if (!isEmbeddedInCerebro()) {
+        return;
+    }
+    const fallbackType = cerebroProcessGroupType(d);
+    processGroup.attr('data-cerebro-canvas-group-type', fallbackType);
+
+    const id = processGroupSelectionId(processGroup, d);
+    if (!id) {
+        return;
+    }
+    processGroup.attr('data-cerebro-process-group-id', id);
+    void loadCerebroProcessGroupType(id)
+        .then((type) => {
+            if (processGroup.attr('data-cerebro-process-group-id') === id) {
+                processGroup.attr('data-cerebro-canvas-group-type', type);
+            }
+        })
+        .catch(() => {
+            if (processGroup.attr('data-cerebro-process-group-id') === id) {
+                processGroup.attr('data-cerebro-canvas-group-type', fallbackType);
+            }
+        });
+}
+
+/** 머리띠 아이콘 · 표시 · 아래 선. 상자를 처음 만들 때(renderProcessGroups · renderProcessors) 한 번. */
+export function appendCerebroHeader(box: any, kind: CerebroBoxKind): void {
+    const header = HEADER[kind];
+    const icon = box
+        .append('g')
+        .attr('class', 'cerebro-head-icon')
+        .attr('display', 'none')
+        .attr('transform', `translate(12, ${(header.height - 14) / 2}) scale(${SVG_ICON_SCALE})`);
+    if (kind === 'group') {
+        icon.append('rect').attr('x', 3).attr('y', 3).attr('width', 13).attr('height', 13).attr('rx', 2);
+        icon.append('rect').attr('x', 8).attr('y', 8).attr('width', 13).attr('height', 13).attr('rx', 2);
+    } else {
+        icon.append('circle').attr('cx', 12).attr('cy', 12).attr('r', 3);
+        icon.append('path').attr('d', GEAR_PATH);
+    }
+
+    box.append('text')
+        .attr('class', 'cerebro-head-tag')
+        .attr('display', 'none')
+        .attr('x', (d: any) => d.dimensions.width - 12)
+        .attr('y', header.height / 2 + 3.5)
+        .text(header.tag);
+
+    box.append('rect')
+        .attr('class', 'cerebro-head-line')
+        .attr('display', 'none')
+        .attr('x', 0)
+        .attr('y', header.height - 1)
+        .attr('width', (d: any) => d.dimensions.width)
+        .attr('height', 1);
+}
+
+/** 프로세서 머리띠 아래 «종류 · 묶음» 띠(그룹의 상태줄 자리). 상세(g.processor-canvas-details)보다 먼저 그려야 글자가 위에 온다. */
+export function appendCerebroProcessorSubBand(processor: any): void {
+    processor
+        .append('rect')
+        .attr('class', 'cerebro-sub-band')
+        .attr('display', 'none')
+        .attr('x', 0)
+        .attr('y', HEADER.processor.height)
+        .attr('width', (d: any) => d.dimensions.width)
+        .attr('height', 26);
+}
+
+/** 지표 표의 이름 칸 바탕(디자인 th). 줄 · 경계선보다 먼저 그려야 경계선이 이름 칸에도 보인다. 위치는 scss. */
+export function appendCerebroLabelColumn(details: any): void {
+    details.append('rect').attr('class', 'cerebro-th-col').attr('display', 'none');
+}
+
+/** «5 min» 알약 바탕. 줄을 다 그린 뒤(글자보다는 먼저) 그린다. 위치는 scss(cerebro-pill-1 … 4 = 지표 줄 번호). */
+export function appendCerebroPills(details: any, rows: number[]): void {
+    rows.forEach((row) => {
+        details.append('rect').attr('class', `cerebro-pill cerebro-pill-${row}`).attr('display', 'none');
+    });
+}
+
+function isShown(node: any, property: 'display' | 'visibility'): boolean {
+    if (node.empty()) {
+        return false;
+    }
+    const value = node.style(property);
+    return property === 'display' ? value !== 'none' : value === 'visible';
+}
+
+/**
+ * 그룹 상태줄 · 바닥줄 배치(디자인 .nifi-status-bar: 양끝 맞춤, .nifi-card-footer: 오른쪽 맞춤 · 간격 12)와 강조 색.
+ * NiFi 가 개수 · 위치를 다시 쓸 때마다(updateProcessGroups) 그리고 알림 표시가 바뀔 때마다(updateProcessGroupStatus) 부른다.
+ * NiFi 에 직접 들어온 경우는 아무것도 하지 않는다(원래 왼쪽부터 차례로 놓는 배치 그대로).
+ */
+export function cerebroLayoutGroupContents(processGroup: any, d: any): void {
+    if (!isEmbeddedInCerebro()) {
+        return;
+    }
+    markCerebroProcessGroupType(processGroup, d);
+    const details = processGroup.select('g.process-group-details');
+    if (details.empty()) {
+        return;
+    }
+    const width: number = d.dimensions.width;
+    const pair = (name: string) => [
+        details.select(`text.process-group-${name}`),
+        details.select(`text.process-group-${name}-count`)
+    ];
+    const textWidth = (node: any) => node.node().getComputedTextLength();
+    const ICON_GAP = 3; // 디자인 .status-stat-item gap 2px + 글자 앞뒤 여백
+
+    const permitted = d.permissions.canRead;
+    const emphasize = (name: string, cls: string, on: boolean) => {
+        const [icon, count] = pair(name);
+        icon.classed(cls, permitted && on);
+        count.classed(cls, permitted && on);
+    };
+    emphasize('stopped', 'cerebro-warn', d.stoppedCount > 0);
+    emphasize('invalid', 'cerebro-alert', d.invalidCount > 0);
+    emphasize('sync-failure', 'cerebro-warn', d.syncFailureCount > 0);
+    emphasize('stale', 'cerebro-alert', d.staleCount > 0);
+    emphasize('locally-modified-and-stale', 'cerebro-alert', d.locallyModifiedAndStaleCount > 0);
+
+    // 상태줄: 왼쪽 12 ~ 오른쪽 12(알림 아이콘이 떠 있으면 그 앞)까지 같은 간격으로.
+    const status = ['transmitting', 'not-transmitting', 'running', 'stopped', 'invalid', 'disabled'].map(pair);
+    const left = 12;
+    const right = isShown(details.select('rect.bulletin-background'), 'visibility') ? width - 32 : width - 12;
+    const widths = status.map(([icon, count]) => textWidth(icon) + ICON_GAP + textWidth(count));
+    const gap = (right - left - widths.reduce((sum, w) => sum + w, 0)) / (status.length - 1);
+    let x = left;
+    status.forEach(([icon, count], i) => {
+        icon.attr('x', x);
+        count.attr('x', x + textWidth(icon) + ICON_GAP);
+        x += widths[i] + gap;
+    });
+
+    // 바닥줄: 오른쪽부터 간격 12(주석 아이콘이 떠 있으면 그 앞).
+    const footer = ['up-to-date', 'locally-modified', 'stale', 'locally-modified-and-stale', 'sync-failure'].map(pair);
+    x = isShown(details.select('text.component-comments'), 'visibility') ? width - 24 : width - 12;
+    footer.reverse().forEach(([icon, count]) => {
+        x -= textWidth(count);
+        count.attr('x', x);
+        x -= ICON_GAP + textWidth(icon);
+        icon.attr('x', x);
+        x -= 12;
+    });
+}
