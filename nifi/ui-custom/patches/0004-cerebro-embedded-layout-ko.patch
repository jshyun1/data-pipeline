+function isProcessorHelpMetadataOnlyText(value: string): boolean {
+    const lines = value
+        .split(/\n|(?:\s{2,})/)
+        .map((line) => line.trim())
+        .filter(Boolean);
+    return lines.length > 0 && lines.every((line) => /^(Expression language scope|Sensitive property|Required field|Identifies Controller Service|Requires Controller Service|History)\s*:/i.test(line));
+}
+
+function processorHelpTooltipTextValue(value: string): string | undefined {
+    if (value.length < 24 || value.length > 3000) {
+        return undefined;
+    }
+    if (/^(Information|Info|Help|도움말|정보)$/i.test(value) || /^도움말\s*보기:/i.test(value)) {
+        return undefined;
+    }
+    if (isProcessorHelpMetadataOnlyText(value)) {
+        return undefined;
+    }
+    return /[.!?。:]|FlowFile|Expression|property|attribute|processor|component|scope|Sensitive|Regular|Controller|Record|Schema/i.test(value)
+        ? value
+        : undefined;
+}
+
+type ProcessorHelpMeta = {
+    description?: string;
+    expressionLanguageScope?: string;
+    sensitive?: boolean;
+    required?: boolean;
+    identifiesControllerService?: boolean;
+    controllerService?: string;
+    history?: string;
+};
+
+function processorHelpMetadata(element: Element): ProcessorHelpMeta {
+    const seen = new WeakSet<object>();
+    const best: ProcessorHelpMeta = {};
+    const assignString = (key: string, value: string): void => {
+        const normalized = value.replace(/\s+/g, ' ').trim();
+        if (!normalized) {
+            return;
+        }
+        const possibleDescription = processorHelpTooltipTextValue(normalized);
+        if (possibleDescription && (!best.description || possibleDescription.length > best.description.length)) {
+            best.description = possibleDescription;
+        }
+        if (/expression.*language.*scope|expressionLanguageScope|elScope/i.test(key)) {
+            best.expressionLanguageScope = normalized;
+        } else if (/sensitive/i.test(key)) {
+            best.sensitive = /^true$/i.test(normalized) ? true : /^false$/i.test(normalized) ? false : best.sensitive;
+        } else if (/required/i.test(key)) {
+            best.required = /^true$/i.test(normalized) ? true : /^false$/i.test(normalized) ? false : best.required;
+        } else if (/history/i.test(key)) {
+            best.history = best.history ? `${best.history}\n${normalized}` : normalized;
+        } else if (/controller.*service|serviceApi|identifiesControllerService/i.test(key)) {
+            best.controllerService = normalized;
+        } else if (/description|toolTip|tooltip|message/i.test(key)) {
+            const text = processorHelpTooltipTextValue(normalized);
+            if (text && (!best.description || text.length > best.description.length)) {
+                best.description = text;
+            }
+        }
+    };
+    const scan = (value: unknown, depth = 0, keyHint = ''): void => {
+        if (typeof value === 'string') {
+            assignString(keyHint, value);
+            return;
+        }
+        if (typeof value === 'boolean') {
+            if (/sensitive/i.test(keyHint)) {
+                best.sensitive = value;
+            } else if (/required/i.test(keyHint)) {
+                best.required = value;
+            } else if (/identifiesControllerService|controllerService/i.test(keyHint)) {
+                best.identifiesControllerService = value;
+            }
+            return;
+        }
+        if (!value || typeof value !== 'object' || depth > 5 || seen.has(value)) {
+            return;
+        }
+        seen.add(value);
+        if (Array.isArray(value)) {
+            value.forEach((item) => scan(item, depth + 1, keyHint));
+            return;
+        }
+        const record = value as Record<string, unknown>;
+        Object.keys(record).slice(0, 160).forEach((key) => scan(record[key], depth + 1, keyHint ? `${keyHint}.${key}` : key));
+    };
+    for (const target of [element, ...Array.from(element.children)]) {
+        const anyTarget = target as Element & Record<string, unknown>;
+        scan(anyTarget['tooltipInputData'], 0, 'tooltipInputData');
+        scan(anyTarget['ngReflectTooltipInputData'], 0, 'ngReflectTooltipInputData');
+        scan(anyTarget['__ngContext__'], 0, '__ngContext__');
+        for (const key of Object.getOwnPropertyNames(anyTarget)) {
+            if (key.includes('ng') || key.toLowerCase().includes('tooltip')) {
+                scan(anyTarget[key], 0, key);
+            }
+        }
+    }
+    return best;
+}
+
+function processorHelpTextFromMeta(meta: ProcessorHelpMeta, fallbackDescription = ''): string {
+    const lines: string[] = [];
+    const description = meta.description || fallbackDescription;
+    if (description) {
+        lines.push(description);
+    }
+    const details: string[] = [];
+    if (meta.expressionLanguageScope) {
+        details.push(`Expression language scope: ${meta.expressionLanguageScope}`);
+    }
+    if (typeof meta.sensitive === 'boolean') {
+        details.push(`Sensitive property: ${meta.sensitive}`);
+    }
+    if (typeof meta.required === 'boolean') {
+        details.push(`Required field: ${meta.required}`);
+    }
+    if (typeof meta.identifiesControllerService === 'boolean') {
+        details.push(`Identifies Controller Service: ${meta.identifiesControllerService}`);
+    }
+    if (meta.controllerService) {
+        details.push(`Requires Controller Service: ${meta.controllerService}`);
+    }
+    if (meta.history) {
+        details.push(`History: ${meta.history}`);
+    }
+    if (details.length > 0) {
+        lines.push('', ...details);
+    }
+    return lines.join('\n');
+}
+
+function processorTooltipOverlayText(): string | undefined {
+    const texts = Array.from(document.querySelectorAll('.cdk-overlay-pane'))
