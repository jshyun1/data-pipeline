+export function translateNifiText(value: string): string | undefined {
+    const trimmed = value.trim();
+    const exact = TEXT[trimmed];
+    if (exact) {
+        return exact;
+    }
+    if (trimmed.startsWith('Active Threads')) {
+        return trimmed.replace('Active Threads', TEXT['Active Threads']);
+    }
+    const displaying = trimmed.match(/^Displaying\s+(\d+)\s+of\s+(\d+)$/i);
+    if (displaying) {
+        return `전체 ${displaying[2]}개 중 ${displaying[1]}개 표시 중`;
+    }
+    const filterMatched = trimmed.match(/^Filter\s+matched\s+(\d+)\s+of\s+(\d+)$/i);
+    if (filterMatched) {
+        return `필터 조건 일치: ${filterMatched[1]} / ${filterMatched[2]}개`;
+    }
+    const oldestEvent = trimmed.match(/^Oldest\s+event\s+available:\s*(.+)$/i);
+    if (oldestEvent) {
+        return `가장 오래된 이벤트: ${oldestEvent[1]}`;
+    }
+    if (/^Maximum\s+Timer\s+Driven\s+Thread\s+Count\b/i.test(trimmed)) {
+        return '최대 타이머 기반 스레드 수';
+    }
+    for (const [pattern, label] of SORTABLE) {
+        const matched = trimmed.match(pattern);
+        if (matched) {
+            return matched[1] ? `${label} ${matched[1]}` : label;
+        }
+    }
+    if (/^In\s+\(Size\)/i.test(trimmed)) {
+        return 'In';
+    }
+    if (/^Out\s+\(Size\)/i.test(trimmed)) {
+        return 'Out';
+    }
+    if (/^Read\s*\|\s*Write/i.test(trimmed)) {
+        return '읽기 | 쓰기';
+    }
+    if (/^Tasks\s*\|\s*Tim/i.test(trimmed)) {
+        return '작업 수 | 시간';
+    }
+    return undefined;
+}
+
+function processorTypeKey(value: string | null | undefined): string | undefined {
+    if (!value) {
+        return undefined;
+    }
+    const typeName = value
+        .replace(/\s+\d+(?:\.\d+)*(?:[-.\w]*)?\s*$/, '')
+        .split('.')
+        .pop()
+        ?.trim();
+    return typeName && PROCESSOR_PROPERTY_TEXT[typeName] ? typeName : undefined;
+}
+
+function translateProcessorPropertyText(value: string, processorType?: string): string | undefined {
+    const typeKey = processorTypeKey(processorType);
+    return (typeKey ? PROCESSOR_PROPERTY_TEXT[typeKey]?.[value] : undefined) ?? COMMON_PROCESSOR_PROPERTY_TEXT[value];
+}
+
+function translateProcessorEditText(
+    value: string,
+    includeFieldLabels = true,
+    includePropertyLabels = false,
+    processorType?: string
+): string | undefined {
+    const trimmed = value.replace(/\s+/g, ' ').trim();
+    const exact = PROCESSOR_EDIT_TEXT[trimmed];
+    if (exact && (
+        includeFieldLabels
+        || PROCESSOR_EDIT_TAB_TEXT.has(trimmed)
+        || (includePropertyLabels && PROCESSOR_EDIT_PROPERTY_UI_TEXT.has(trimmed))
+    )) {
+        return exact;
+    }
+    const normalized = trimmed.replace(/\s*\*$/, '');
+    const normalizedExact = PROCESSOR_EDIT_TEXT[normalized];
+    if (normalizedExact && (
+        includeFieldLabels
+        || PROCESSOR_EDIT_TAB_TEXT.has(normalized)
+        || (includePropertyLabels && PROCESSOR_EDIT_PROPERTY_UI_TEXT.has(normalized))
+    )) {
+        return `${normalizedExact}${trimmed.endsWith('*') ? '*' : ''}`;
+    }
+    const property = includePropertyLabels ? translateProcessorPropertyText(trimmed, processorType) : undefined;
+    if (property) {
+        return `${property}(${trimmed})`;
+    }
+    return undefined;
+}
