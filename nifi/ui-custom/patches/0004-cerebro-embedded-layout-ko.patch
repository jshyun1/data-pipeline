+function processorHelpTooltipText(element: Element): string | undefined {
+    const values = ATTRIBUTES
+        .filter((name) => name !== 'placeholder')
+        .map((name) => element.getAttribute(name)?.replace(/\s+/g, ' ').trim())
+        .filter((value): value is string => Boolean(value));
+    const useful = values.filter((value) => {
+        if (value.length < 24 || value.length > 3000) {
+            return false;
+        }
+        if (/^(Information|Info|Help|도움말|정보)$/i.test(value) || /^도움말\s*보기:/i.test(value)) {
+            return false;
+        }
+        return /[.!?。:]|FlowFile|Expression|property|attribute|processor|component|scope|Sensitive|Regular|Controller|Record|Schema/i.test(value);
+    });
+    return useful.sort((a, b) => b.length - a.length)[0];
+}
+
+function angularTooltipInputData(element: Element): string | undefined {
+    const seen = new WeakSet<object>();
+    const scan = (value: unknown, depth = 0): string | undefined => {
+        if (typeof value === 'string') {
+            const normalized = value.replace(/\s+/g, ' ').trim();
+            return processorHelpTooltipTextValue(normalized);
+        }
+        if (!value || typeof value !== 'object' || depth > 4 || seen.has(value)) {
+            return undefined;
+        }
+        seen.add(value);
+        const record = value as Record<string, unknown>;
+        const direct = scan(record['tooltipInputData'], depth + 1) ?? scan(record['ngReflectTooltipInputData'], depth + 1);
+        if (direct) {
+            return direct;
+        }
+        if (Array.isArray(value)) {
+            for (const item of value) {
+                const found = scan(item, depth + 1);
+                if (found) {
+                    return found;
+                }
+            }
+            return undefined;
+        }
+        const keys = Object.keys(record);
+        const prioritized = [
+            ...keys.filter((key) => /tooltip|tip|data|input|description|descriptor|text|message/i.test(key)),
+            ...keys.filter((key) => !/tooltip|tip|data|input|description|descriptor|text|message/i.test(key))
+        ];
+        for (const key of prioritized.slice(0, 120)) {
+            const found = scan(record[key], depth + 1);
+            if (found) {
+                return found;
+            }
+        }
+        return undefined;
+    };
+    for (const target of [element, ...Array.from(element.children)]) {
+        const anyTarget = target as Element & Record<string, unknown>;
+        const found = scan(anyTarget['tooltipInputData'])
+            ?? scan(anyTarget['ngReflectTooltipInputData'])
+            ?? scan(anyTarget['__ngContext__']);
+        if (found) {
+            return found;
+        }
+        for (const key of Object.getOwnPropertyNames(anyTarget)) {
+            if (!key.includes('ng') && !key.toLowerCase().includes('tooltip')) {
+                continue;
+            }
+            const value = anyTarget[key];
+            const foundFromProperty = scan(value);
+            if (foundFromProperty) {
+                return foundFromProperty;
+            }
+        }
+    }
+    return undefined;
+}
