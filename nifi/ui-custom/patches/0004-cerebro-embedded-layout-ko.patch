+}
+
+function parseProcessorHelpMeta(value: string | null): ProcessorHelpMeta {
+    if (!value) {
+        return {};
+    }
+    try {
+        return JSON.parse(value) as ProcessorHelpMeta;
+    } catch {
+        return {};
+    }
+}
+
+function processorPropertyValue(element: Element): string {
+    const row = closestProcessorPropertyRow(element);
+    const cells = row ? Array.from(row.querySelectorAll("td, [role='cell'], .mat-mdc-cell, .mat-cell")) : [];
+    const valueCell = cells.length >= 2 ? cells[1] : undefined;
+    const value = elementText(valueCell ?? row ?? element)
+        .replace(elementText(cells[0] ?? element), '')
+        .replace(/\s+/g, ' ')
+        .trim();
+    return /^(No value set|값 없음)$/i.test(value) ? '' : value;
+}
+
+function processorRuleBasedInterpretation(title: string, helpText: string, value: string): string {
+    const propertyName = processorEnglishPropertyTitle(title);
+    const currentValue = value ? ` 현재 값은 "${value}"입니다.` : '';
+    if (/Connection Pooling Service/i.test(propertyName)) {
+        return `이 속성은 Processor가 데이터베이스에 연결할 때 사용할 연결 풀 서비스를 지정합니다.${currentValue} 연결 정보, 드라이버, 계정은 선택한 Controller Service에서 관리됩니다.`;
+    }
+    if (/SQL/i.test(propertyName)) {
+        return `이 속성은 실행할 SQL 또는 SQL 실행 전후 처리를 정의합니다.${currentValue} FlowFile 내용과 Expression Language 사용 여부가 원문 설명과 맞는지 확인하세요.`;
+    }
+    if (/Record Writer/i.test(propertyName)) {
+        return `이 속성은 조회 결과를 어떤 레코드 형식으로 쓸지 결정합니다.${currentValue} 후속 Processor가 읽을 수 있는 Writer를 선택해야 합니다.`;
+    }
+    if (/Wait Time|Timeout/i.test(propertyName)) {
+        return `이 속성은 작업이 완료되기를 기다리는 최대 시간을 정합니다.${currentValue} 값이 너무 짧으면 느린 DB 작업이 실패할 수 있습니다.`;
+    }
+    return `${title} 속성은 NiFi descriptor 원문에 따라 동작합니다.${currentValue} 핵심은 다음 설명입니다: ${helpText}`;
+}
+
+function requestProcessorHelpInterpretation(payload: {
+    processorType: string;
+    propertyName: string;
+    propertyValue: string;
+    description: string;
+    expressionLanguageScope?: string;
+    sensitive?: boolean;
+    identifiesControllerService?: boolean;
+}): void {
+    if (!payload.description || payload.description === '이 항목의 상세 설명을 찾지 못했습니다.') {
+        return;
+    }
+    const token = window.localStorage.getItem('cerebro_token');
+    fetch('/api/llm/nifi/property-help', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: {
+            'Content-Type': 'application/json',
+            ...(token ? { Authorization: `Bearer ${token}` } : {})
+        },
+        body: JSON.stringify(payload)
+    })
+        .then((response) => response.ok ? response.json() : Promise.reject(new Error(String(response.status))))
+        .then((json) => {
+            const data = json?.data;
+            if (data?.interpretation) {
+                updateProcessorHelpInterpretation(data.interpretation, data.providerName);
+            }
+        })
+        .catch(() => {
+            // 로그인 만료, LLM 미설정, 네트워크 오류 때는 이미 표시한 규칙 기반 해석을 유지한다.
+        });
+}
+
+function closestProcessorPropertyRow(element: Element): Element | null {
+    const direct = element.closest("tr, [role='row'], .mat-mdc-row, .mat-row, .property-row, .editable-table-row");
+    if (direct) {
+        return direct;
+    }
+    let current = element.parentElement;
+    for (let depth = 0; depth < 5 && current && current !== document.body; depth += 1) {
+        const rect = current.getBoundingClientRect();
+        const text = elementText(current);
+        if (rect.width >= 180 && rect.height > 0 && rect.height <= 90 && text.length <= 500) {
+            return current;
+        }
+        current = current.parentElement;
+    }
+    return null;
+}
+
+function cleanProcessorPropertyLabel(value: string, helpText: string): string {
+    return value
+        .replace(helpText, '')
+        .replace(/\b(No value set|Required field|Supports expression language|Sensitive property)\b/gi, '')
+        .replace(/필수\s*항목|값\s*없음/g, '')
+        .replace(/\s+/g, ' ')
+        .replace(/\s*\*$/, '')
+        .trim();
+}
+
+function processorHelpTitle(element: Element, helpText: string, processorType?: string): string {
+    const row = closestProcessorPropertyRow(element);
+    const cell = row?.querySelector("td, [role='cell'], .property-name, .setting-name, .mat-column-name");
+    const rawTitle = cleanProcessorPropertyLabel(
+        (cell ? elementText(cell) : '') || cleanProcessorPropertyLabel(elementText(row ?? element), helpText),
+        helpText
+    );
+    const englishMatch = rawTitle.match(/\(([^()]+)\)\s*$/);
+    if (englishMatch?.[1]) {
+        const korean = rawTitle.slice(0, englishMatch.index).trim();
+        return korean ? `${korean}(${englishMatch[1].trim()})` : englishMatch[1].trim();
+    }
+    const englishTitle = rawTitle || 'Processor Property';
+    const koreanTitle = translateProcessorPropertyText(englishTitle, processorType);
+    return koreanTitle ? `${koreanTitle}(${englishTitle})` : englishTitle;
+}
+
+function prepareProcessorHelpTarget(element: Element, dialog: Element, processorType?: string): void {
+    if (element.hasAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE)) {
+        return;
+    }
+    const helpText = processorHelpTooltipText(element);
+    if (!helpText) {
+        return;
+    }
+    const meta = processorHelpMetadata(element);
+    const fullHelpText = processorHelpTextFromMeta(meta, helpText);
+    const title = processorHelpTitle(element, helpText, processorType);
+    element.setAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE, fullHelpText);
+    element.setAttribute(PROCESSOR_HELP_TITLE_ATTRIBUTE, title);
+    element.setAttribute(PROCESSOR_HELP_CONTEXT_ATTRIBUTE, processorHelpContext(dialog));
+    element.setAttribute(PROCESSOR_HELP_PROCESSOR_TYPE_ATTRIBUTE, processorType ?? '');
+    element.setAttribute(PROCESSOR_HELP_VALUE_ATTRIBUTE, processorPropertyValue(element));
+    element.setAttribute(PROCESSOR_HELP_META_ATTRIBUTE, JSON.stringify(meta));
+    element.setAttribute('role', element.getAttribute('role') ?? 'button');
+    element.setAttribute('tabindex', element.getAttribute('tabindex') ?? '0');
+    element.setAttribute('aria-label', `도움말 보기: ${title}`);
+    ['title', 'data-tooltip', 'matTooltip', 'mattooltip', 'ng-reflect-message', 'data-mat-tooltip', 'data-original-title', 'tooltipInputData', 'ng-reflect-tooltip-input-data', 'tooltip'].forEach((name) => {
+        element.removeAttribute(name);
+    });
+}
+
+function prepareProcessorHelpIconTarget(element: Element, dialog: Element, processorType?: string): void {
+    if (element.hasAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE)) {
+        return;
+    }
+    const meta = processorHelpMetadata(element);
+    const helpText = processorHelpTooltipText(element) ?? angularTooltipInputData(element) ?? meta.description ?? '';
+    const fullHelpText = processorHelpTextFromMeta(meta, helpText);
+    const title = processorHelpTitle(element, helpText, processorType);
+    element.setAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE, fullHelpText);
+    element.setAttribute(PROCESSOR_HELP_TITLE_ATTRIBUTE, title);
+    element.setAttribute(PROCESSOR_HELP_CONTEXT_ATTRIBUTE, processorHelpContext(dialog));
+    element.setAttribute(PROCESSOR_HELP_PROCESSOR_TYPE_ATTRIBUTE, processorType ?? '');
+    element.setAttribute(PROCESSOR_HELP_VALUE_ATTRIBUTE, processorPropertyValue(element));
+    element.setAttribute(PROCESSOR_HELP_META_ATTRIBUTE, JSON.stringify(meta));
+    element.setAttribute('role', element.getAttribute('role') ?? 'button');
+    element.setAttribute('tabindex', element.getAttribute('tabindex') ?? '0');
+    element.setAttribute('aria-label', `도움말 보기: ${title}`);
+}
+
+function replaceProcessorHelpIconTarget(element: Element, dialog: Element, processorType?: string): Element {
+    if (element.hasAttribute(PROCESSOR_HELP_REPLACED_ATTRIBUTE)) {
+        prepareProcessorHelpIconTarget(element, dialog, processorType);
+        return element;
+    }
+    if (element.getAttribute(PROCESSOR_HELP_PROBING_ATTRIBUTE) === 'true') {
+        return element;
+    }
+    prepareProcessorHelpIconTarget(element, dialog, processorType);
+    element.setAttribute(PROCESSOR_HELP_PROBING_ATTRIBUTE, 'true');
+    element.setAttribute(PROCESSOR_HELP_PROBE_ATTRIBUTE, 'true');
+    const dispatchProbeEvent = (type: string): void => {
+        element.dispatchEvent(new MouseEvent(type, {
+            bubbles: type !== 'mouseenter' && type !== 'mouseleave',
+            cancelable: true,
+            view: window
+        }));
+    };
+    dispatchProbeEvent('mouseover');
+    dispatchProbeEvent('mouseenter');
+    dispatchProbeEvent('mousemove');
+    element.dispatchEvent(new FocusEvent('focusin', { bubbles: true, cancelable: true }));
+    const captureOverlayHelpText = (): void => {
+        const overlayHelpText = processorTooltipOverlayText();
+        if (overlayHelpText && overlayHelpText.length > (element.getAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE)?.length ?? 0)) {
+            const meta = processorHelpMetadata(element);
+            const fullHelpText = processorHelpTextFromMeta(meta, overlayHelpText);
+            element.setAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE, fullHelpText || overlayHelpText);
+            element.setAttribute(PROCESSOR_HELP_META_ATTRIBUTE, JSON.stringify(meta));
+        }
+    };
+    [120, 320].forEach((delay) => window.setTimeout(captureOverlayHelpText, delay));
+    window.setTimeout(() => {
+        captureOverlayHelpText();
+        dispatchProbeEvent('mouseleave');
+        dispatchProbeEvent('mouseout');
+        element.dispatchEvent(new FocusEvent('focusout', { bubbles: true, cancelable: true }));
+        element.removeAttribute(PROCESSOR_HELP_PROBE_ATTRIBUTE);
+        element.removeAttribute(PROCESSOR_HELP_PROBING_ATTRIBUTE);
+        if (!element.isConnected || element.hasAttribute(PROCESSOR_HELP_REPLACED_ATTRIBUTE)) {
+            return;
+        }
+        const clone = element.cloneNode(true) as Element;
+        clone.setAttribute(PROCESSOR_HELP_REPLACED_ATTRIBUTE, 'true');
+        clone.removeAttribute(PROCESSOR_HELP_PROBE_ATTRIBUTE);
+        clone.removeAttribute(PROCESSOR_HELP_PROBING_ATTRIBUTE);
+        ['title', 'data-tooltip', 'matTooltip', 'mattooltip', 'ng-reflect-message', 'data-mat-tooltip', 'data-original-title', 'tooltipInputData', 'ng-reflect-tooltip-input-data', 'tooltip'].forEach((name) => {
+            clone.removeAttribute(name);
+        });
+        element.replaceWith(clone);
+    }, 520);
+    return element;
+}
+
+function isProcessorHelpHoverTarget(target: EventTarget | null): boolean {
+    if (!(target instanceof Element)) {
+        return false;
+    }
+    return Boolean(target.closest(
+        [
+            `[${PROCESSOR_HELP_TEXT_ATTRIBUTE}]`,
+            PROCESSOR_HELP_ICON_SELECTOR,
+            '.processor-configuration .fa-info-circle',
+            '.processor-configuration [nifiTooltip]',
+            '.processor-configuration [tooltipInputData]',
+            '.processor-configuration [ng-reflect-tooltip-input-data]',
+            ".cdk-overlay-pane:has(.processor-configuration) .fa-info-circle",
+            ".cdk-overlay-pane[data-cerebro-processor-dialog-fit-target='true'] .fa-info-circle"
+        ].join(', ')
+    ));
+}
+
+function installProcessorPropertyHelpPopup(): void {
+    ensureProcessorHelpStyle();
+    if (document.body) {
+        ensureProcessorHelpModal();
+    }
+    findProcessorEditDialogs().forEach((dialog) => {
+        const processorType = processorEditType(dialog);
+        const selector = ATTRIBUTES
+            .filter((name) => name !== 'placeholder')
+            .map((name) => `[${name}]`)
+            .join(', ');
+        dialog.querySelectorAll(selector).forEach((element) => prepareProcessorHelpTarget(element, dialog, processorType));
+        dialog.querySelectorAll(PROCESSOR_HELP_ICON_SELECTOR).forEach((element) => {
+            replaceProcessorHelpIconTarget(element, dialog, processorType);
+        });
+    });
+
+    if (document.documentElement.getAttribute(PROCESSOR_HELP_READY_ATTRIBUTE) === 'true') {
+        return;
+    }
+    document.documentElement.setAttribute(PROCESSOR_HELP_READY_ATTRIBUTE, 'true');
+
+    const suppressOriginalTooltip = (event: Event): void => {
+        const target = event.target instanceof Element ? event.target.closest(`[${PROCESSOR_HELP_TEXT_ATTRIBUTE}]`) : null;
+        if (target?.getAttribute(PROCESSOR_HELP_PROBE_ATTRIBUTE) === 'true') {
+            return;
+        }
+        if (isProcessorHelpHoverTarget(event.target)) {
+            event.preventDefault();
+            event.stopPropagation();
+            event.stopImmediatePropagation();
+        }
+    };
+    document.addEventListener('mouseover', suppressOriginalTooltip, true);
+    document.addEventListener('mouseenter', suppressOriginalTooltip, true);
+    document.addEventListener('mousemove', suppressOriginalTooltip, true);
+    document.addEventListener('pointerover', suppressOriginalTooltip, true);
+    document.addEventListener('pointerenter', suppressOriginalTooltip, true);
+    document.addEventListener('focusin', suppressOriginalTooltip, true);
+
+    document.addEventListener('click', (event) => {
+        const closeTarget = event.target instanceof Element ? event.target.closest("[data-cerebro-help-close='true']") : null;
+        const modal = document.getElementById(PROCESSOR_HELP_MODAL_ID);
+        if (closeTarget || event.target === modal) {
+            event.preventDefault();
+            event.stopPropagation();
+            closeProcessorHelpModal();
+            return;
+        }
+        const target = event.target instanceof Element ? event.target.closest(`[${PROCESSOR_HELP_TEXT_ATTRIBUTE}]`) : null;
+        if (!target) {
+            return;
+        }
+        event.preventDefault();
+        event.stopPropagation();
+        const title = target.getAttribute(PROCESSOR_HELP_TITLE_ATTRIBUTE) ?? 'Processor Property';
+        const processorType = target.getAttribute(PROCESSOR_HELP_PROCESSOR_TYPE_ATTRIBUTE) ?? '';
+        const propertyValue = target.getAttribute(PROCESSOR_HELP_VALUE_ATTRIBUTE) ?? '';
+        const meta = parseProcessorHelpMeta(target.getAttribute(PROCESSOR_HELP_META_ATTRIBUTE));
+        const storedHelpText = target.getAttribute(PROCESSOR_HELP_TEXT_ATTRIBUTE)?.trim() ?? '';
+        const helpText = processorTooltipOverlayText()
+            || storedHelpText
+            || processorFallbackHelpText(title)
+            || '';
+        const description = helpText || '이 항목의 상세 설명을 찾지 못했습니다.';
+        openProcessorHelpModal(title, description, processorRuleBasedInterpretation(title, description, propertyValue));
+        requestProcessorHelpInterpretation({
+            processorType,
+            propertyName: processorEnglishPropertyTitle(title),
+            propertyValue,
+            description,
+            expressionLanguageScope: meta.expressionLanguageScope,
+            sensitive: meta.sensitive,
+            identifiesControllerService: meta.identifiesControllerService
+        });
+    }, true);
+
+    document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+            closeProcessorHelpModal();
+            return;
+        }
+        if (event.key !== 'Enter' && event.key !== ' ') {
+            return;
+        }
+        const target = event.target instanceof Element ? event.target.closest(`[${PROCESSOR_HELP_TEXT_ATTRIBUTE}]`) : null;
+        if (!target) {
+            return;
+        }
+        event.preventDefault();
+        event.stopPropagation();
+        target.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
+    }, true);
+}
+
+function translateTextNode(node: Text): void {
+    const value = node.nodeValue ?? '';
+    const trimmed = value.trim();
+    if (!trimmed || trimmed.length > 80 || trimmed.includes('\n')) {
+        return;
+    }
+    const parent = node.parentElement;
+    if (!parent || SKIP_PARENTS.has(parent.tagName)) {
+        return;
+    }
+    const translated = inMenuOverlay(node)
+        ? translateNifiText(trimmed)
+        : inDialog(node)
+        ? translateProcessorEditText(
+            trimmed,
+            allowsDialogFieldTranslation(parent) || isProcessorEditTabLabel(parent),
+            allowsDialogPropertyTranslation(parent),
+            processorEditType(parent)
+        )
+        : translateNifiText(trimmed);
+    if (translated && translated !== trimmed) {
+        node.nodeValue = value.replace(trimmed, translated);
+    }
+}
+
+function translateAttributes(element: Element): void {
+    for (const name of ATTRIBUTES) {
+        const value = element.getAttribute(name);
+        const translated = value
+            ? (inMenuOverlay(element)
+                ? translateNifiText(value)
+                : inDialog(element)
+                ? translateProcessorEditText(
+                    value,
+                    allowsDialogFieldTranslation(element) || isProcessorEditTabLabel(element),
+                    allowsDialogPropertyTranslation(element),
+                    processorEditType(element)
+                )
+                : translateNifiText(value))
+            : undefined;
+        if (translated && translated !== value) {
+            element.setAttribute(name, translated);
+        }
+    }
+}
+
+function hideContextMenuItem(element: Element): void {
+    const text = elementText(element);
+    if (!HIDDEN_CONTEXT_MENU_ITEMS.has(text)) {
+        return;
+    }
+    const item = element.closest('[role="menuitem"], .mat-mdc-menu-item, .mat-menu-item, button, a, li') as HTMLElement | null;
+    if (!item) {
+        return;
+    }
+    item.setAttribute('aria-hidden', 'true');
+    item.setAttribute('hidden', 'true');
+    item.style.setProperty('display', 'none', 'important');
+}
+
+function translateTree(root: Node): void {
+    if (root.nodeType === Node.TEXT_NODE) {
+        translateTextNode(root as Text);
+        return;
+    }
+    if (!(root instanceof Element)) {
+        return;
+    }
+    translateAttributes(root);
+    hideContextMenuItem(root);
+    root.querySelectorAll(ATTRIBUTES.map((name) => `[${name}]`).join(', ')).forEach(translateAttributes);
+    root.querySelectorAll('[role="menuitem"], .mat-mdc-menu-item, .mat-menu-item, button, a, li').forEach(hideContextMenuItem);
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        translateTextNode(node as Text);
+        if (node.parentElement) {
+            hideContextMenuItem(node.parentElement);
+        }
+    }
+    installProcessorPropertyHelpPopup();
+}
+
+/** 앱이 그리기 전에 한 번 부른다. 그 뒤로는 새로 붙거나 바뀐 글자 · 속성만 바꾼다. */
+export function startCerebroKoreanText(): void {
+    const observer = new MutationObserver((mutations) => {
+        for (const mutation of mutations) {
+            if (mutation.type === 'characterData') {
+                translateTextNode(mutation.target as Text);
+            } else if (mutation.type === 'attributes') {
+                translateAttributes(mutation.target as Element);
+            } else {
+                mutation.addedNodes.forEach(translateTree);
+            }
+        }
+        installProcessorPropertyHelpPopup();
+    });
+    observer.observe(document.documentElement, {
+        childList: true,
+        subtree: true,
+        characterData: true,
+        attributes: true,
+        attributeFilter: ATTRIBUTES
+    });
+    translateTree(document.body);
+    installProcessorPropertyHelpPopup();
+}
