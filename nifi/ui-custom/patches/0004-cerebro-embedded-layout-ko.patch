+/*
+ * Cerebro 맞춤 (Cerebro 저장소 nifi/ui-custom/patches 로 관리한다 - NiFi 원본 소스에는 없는 파일).
+ *
+ * Cerebro «ETL 관리» 화면(iframe) 안에서의 NiFi 배치. html.cerebro-embedded 일 때만(cerebro-ui.ts) - NiFi 에 직접 들어오면 원래 배치.
+ * 예전 ConsoleFramePage 의 HIDE_TOOL_CHROME_CSS 를 옮긴 것이다(2026-10-05). 그때는 NiFi 가 다 그린 뒤 JS 가 요소마다 표식을 달아야
+ * 적용돼서 첫 진입 때 원래 배치(위쪽 머리줄 · 상태줄)가 0.4초쯤 보였다. 여기서는 처음 그릴 때부터 이 배치다.
+ *
+ *   머리줄      → 왼쪽 아래 세로 공구막대(도구 3개, Cerebro 아이콘 · 마우스 올리면 이름). 상태줄 · 메뉴 단추는 숨김
+ *   아래 경로줄 → 숨김(왼쪽 트리가 위치를 보여준다), 작업 패널의 «선택 항목» 칸도 숨김(예전 덧칠과 같은 모습)
+ *   캔버스      → 흰 바탕, 프로세스 그룹 상자 색
+ */
+html.cerebro-embedded {
+    .splash {
+        display: none !important;
+    }
+
+    // ETL 이 띄우는 안내 글자(«프로세스 그룹» 등)는 이 겹침 칸에 그려진다 - 공구막대(아래 z-index)보다 위로.
+    .cdk-overlay-container {
+        z-index: 100010 !important;
+    }
+
+    fd-header header.nifi-header {
+        position: fixed !important;
+        left: 14px !important;
+        bottom: 14px !important;
+        // 캔버스 쪽 패널(9100)보다 위 - 왼쪽 아래 구석의 작은 칸이라 다른 조작을 가리지 않는다.
+        z-index: 100000 !important;
+        width: 42px !important;
+        padding: 6px 5px !important;
+        display: flex !important;
+        flex-direction: column !important;
+        align-items: center !important;
+        gap: 6px !important;
+        background: #ffffff !important;
+        border: 1px solid #dbe3ee !important;
+        border-radius: 9px !important;
+        box-shadow: 0 2px 8px rgb(15 23 42 / 9%) !important;
+        overflow: visible !important;
+
+        > flow-status {
+            display: none !important;
+        }
+
+        navigation,
+        navigation > div,
+        nav.nifi-navigation,
+        nav.nifi-navigation > div,
+        nav.nifi-navigation > div > div:first-child {
+            display: flex !important;
+            flex-direction: column !important;
+            align-items: center !important;
+            gap: 6px !important;
+            width: auto !important;
+            height: auto !important;
+            min-height: 0 !important;
+            margin: 0 !important;
+            padding: 0 !important;
+            background: transparent !important;
+            border: 0 !important;
+            box-shadow: none !important;
+        }
+
+        // 사용자 이름(0001 이 안 그림) · 전역 메뉴 단추 묶음
+        nav.nifi-navigation > div > div:not(:first-child) {
+            display: none !important;
+        }
+
+        new-canvas-item {
+            position: relative !important;
+            width: 30px !important;
+            height: 30px !important;
+            min-width: 30px !important;
+            min-height: 30px !important;
+            margin: 0 !important;
+            padding: 0 !important;
+            display: inline-flex !important;
+            align-items: center !important;
+            justify-content: center !important;
+            border: 1px solid #dbe3ee !important;
+            border-radius: 6px !important;
+            background: #ffffff !important;
+            color: #475569 !important;
+            box-shadow: 0 1px 2px rgb(15 23 42 / 8%) !important;
+            overflow: hidden !important;
+            cursor: grab !important;
+            user-select: none !important;
+            touch-action: none !important;
+
+            &:active {
+                cursor: grabbing !important;
+            }
+
+            &:hover {
+                overflow: visible !important;
+                background: #f8fafc !important;
+                color: #0f172a !important;
+            }
+
+            &[tooltip='프로세스 그룹'] {
+                border-color: #ff3b30 !important;
+                background: #ffffff !important;
+                color: #ff3b30 !important;
+                box-shadow: none !important;
+            }
+
+            // NiFi 원래 도구(끌어다 놓기를 맡는다)는 투명하게 위에 둔다 - 보이는 것은 아래의 Cerebro 아이콘.
+            > :not(.cerebro-tool-icon),
+            > :not(.cerebro-tool-icon) * {
+                opacity: 0 !important;
+                background: transparent !important;
+                border-color: transparent !important;
+                box-shadow: none !important;
+            }
+
+            > :not(.cerebro-tool-icon) {
+                z-index: 2 !important;
+                pointer-events: auto !important;
+            }
+
+            .cerebro-tool-icon {
+                position: absolute !important;
+                inset: 0 !important;
+                width: 18px !important;
+                height: 18px !important;
+                margin: auto !important;
+                pointer-events: none !important;
+                z-index: 1 !important;
+
+                * {
+                    vector-effect: non-scaling-stroke;
+                }
+            }
+
+            // 마우스를 올리면 오른쪽에 이름
