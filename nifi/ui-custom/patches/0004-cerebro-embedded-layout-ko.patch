+                font-weight: 600;
+                line-height: 1.2;
+                white-space: nowrap;
+                box-shadow: 0 6px 16px rgb(15 23 42 / 18%);
+                pointer-events: none;
+            }
+
+            &:hover::before {
+                content: '';
+                position: absolute;
+                left: calc(100% + 3px);
+                top: 50%;
+                transform: translateY(-50%) rotate(45deg);
+                z-index: 100001;
+                width: 8px;
+                height: 8px;
+                background: #0f172a;
+                pointer-events: none;
+            }
+        }
+    }
