+        .icon-stop {
+            fill: #ef4444 !important;
+            color: #ef4444 !important;
+        }
+
+        .refresh-interval,
+        .status-history {
+            fill: #f1f5f9 !important;
+            stroke: #dbe4ee !important;
+        }
+    }
+}
