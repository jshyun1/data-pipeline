+const ATTRIBUTES = ['title', 'aria-label', 'data-tooltip', 'mattooltip', 'tooltip', 'placeholder'];
+const DIALOG_SELECTOR = '[role="dialog"], .mat-dialog-container, .mat-mdc-dialog-container, .processor-configuration';
+const SKIP_PARENTS = new Set(['SCRIPT', 'STYLE', 'TEXTAREA']);
+
+const SORTABLE: Array<[RegExp, string]> = [
+    [/^Name\s*([↑↓])?$/, '이름'],
+    [/^Provider\s*([↑↓])?$/, '제공자'],
+    [/^Description\s*([↑↓])?$/, '설명'],
+    [/^Id\s*([↑↓])?$/i, 'ID'],
+    [/^Date\/Time\s*([↑↓])?$/, '일시'],
+    [/^Operation\s*([↑↓])?$/, '작업'],
+    [/^User\s*([↑↓])?$/, '사용자']
+];
+
+export function translateNifiText(value: string): string | undefined {
+    const trimmed = value.trim();
+    const exact = TEXT[trimmed];
+    if (exact) {
+        return exact;
+    }
+    if (trimmed.startsWith('Active Threads')) {
+        return trimmed.replace('Active Threads', TEXT['Active Threads']);
+    }
+    const displaying = trimmed.match(/^Displaying\s+(\d+)\s+of\s+(\d+)$/i);
+    if (displaying) {
+        return `전체 ${displaying[2]}개 중 ${displaying[1]}개 표시 중`;
+    }
+    const filterMatched = trimmed.match(/^Filter\s+matched\s+(\d+)\s+of\s+(\d+)$/i);
+    if (filterMatched) {
+        return `필터 조건 일치: ${filterMatched[1]} / ${filterMatched[2]}개`;
+    }
+    const oldestEvent = trimmed.match(/^Oldest\s+event\s+available:\s*(.+)$/i);
+    if (oldestEvent) {
+        return `가장 오래된 이벤트: ${oldestEvent[1]}`;
+    }
+    if (/^Maximum\s+Timer\s+Driven\s+Thread\s+Count\b/i.test(trimmed)) {
+        return '최대 타이머 기반 스레드 수';
+    }
+    for (const [pattern, label] of SORTABLE) {
+        const matched = trimmed.match(pattern);
+        if (matched) {
+            return matched[1] ? `${label} ${matched[1]}` : label;
+        }
+    }
+    if (/^In\s+\(Size\)/i.test(trimmed)) {
+        return 'In';
+    }
+    if (/^Out\s+\(Size\)/i.test(trimmed)) {
+        return 'Out';
+    }
+    if (/^Read\s*\|\s*Write/i.test(trimmed)) {
+        return '읽기 | 쓰기';
+    }
+    if (/^Tasks\s*\|\s*Tim/i.test(trimmed)) {
+        return '작업 수 | 시간';
+    }
+    return undefined;
+}
+
+function inDialog(node: Node): boolean {
+    const element = node instanceof Element ? node : node.parentElement;
+    return Boolean(element?.closest(DIALOG_SELECTOR));
+}
+
+function translateTextNode(node: Text): void {
+    const value = node.nodeValue ?? '';
+    const trimmed = value.trim();
+    if (!trimmed || trimmed.length > 80 || trimmed.includes('\n')) {
+        return;
+    }
+    const parent = node.parentElement;
+    if (!parent || SKIP_PARENTS.has(parent.tagName) || inDialog(node)) {
+        return;
+    }
+    const translated = translateNifiText(trimmed);
+    if (translated && translated !== trimmed) {
+        node.nodeValue = value.replace(trimmed, translated);
+    }
+}
+
+function translateAttributes(element: Element): void {
+    if (inDialog(element)) {
+        return;
+    }
+    for (const name of ATTRIBUTES) {
+        const value = element.getAttribute(name);
+        const translated = value ? translateNifiText(value) : undefined;
+        if (translated && translated !== value) {
+            element.setAttribute(name, translated);
+        }
+    }
+}
+
+function translateTree(root: Node): void {
+    if (root.nodeType === Node.TEXT_NODE) {
+        translateTextNode(root as Text);
+        return;
+    }
+    if (!(root instanceof Element) || root.closest(DIALOG_SELECTOR)) {
+        return;
+    }
+    translateAttributes(root);
+    root.querySelectorAll(ATTRIBUTES.map((name) => `[${name}]`).join(', ')).forEach(translateAttributes);
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        translateTextNode(node as Text);
+    }
+}
+
+/** 앱이 그리기 전에 한 번 부른다. 그 뒤로는 새로 붙거나 바뀐 글자 · 속성만 바꾼다. */
+export function startCerebroKoreanText(): void {
+    const observer = new MutationObserver((mutations) => {
+        for (const mutation of mutations) {
+            if (mutation.type === 'characterData') {
+                translateTextNode(mutation.target as Text);
+            } else if (mutation.type === 'attributes') {
+                translateAttributes(mutation.target as Element);
+            } else {
+                mutation.addedNodes.forEach(translateTree);
+            }
+        }
+    });
+    observer.observe(document.documentElement, {
+        childList: true,
+        subtree: true,
+        characterData: true,
+        attributes: true,
+        attributeFilter: ATTRIBUTES
+    });
+    translateTree(document.body);
+}
