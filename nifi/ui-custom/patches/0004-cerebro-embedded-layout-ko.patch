+            }
+            return !/(Edit\s+Processor|프로세서\s*편집|설정\s+스케줄링\s+속성)/i.test(text);
+        });
+    return texts.sort((a, b) => b.length - a.length)[0];
+}
+
+function processorEnglishPropertyTitle(title: string): string {
+    const englishMatch = title.match(/\(([^()]+)\)\s*$/);
+    return (englishMatch?.[1] ?? title)
+        .replace(/\s+/g, ' ')
+        .replace(/\s*\*$/, '')
+        .trim();
+}
+
+function processorFallbackHelpText(title: string): string | undefined {
+    const englishTitle = processorEnglishPropertyTitle(title);
