+ * main.ts 가 앱을 띄우기 전에 부른다.
+ *  - <html data-cerebro-nifi-ui>: «Cerebro 판 NiFi 화면»이라는 표시. Cerebro ETL 관리 화면(ConsoleFramePage)이 이걸 보고
+ *    iframe 밖에서 하던 덧칠(배치 바꾸기 · 한글 바꾸기)을 건너뛴다. 공식 화면으로 되돌리면 표시가 없어 예전 덧칠이 다시 돈다.
+ *  - <html class="cerebro-embedded">: Cerebro 안(iframe)에서 열렸을 때만. _cerebro-embedded.scss 가 이 아래에서만 배치를 바꾼다.
+ */
+import { isEmbeddedInCerebro } from './cerebro-embed';
+import { startCerebroKoreanText } from './cerebro-ko';
+
+type RecentPanel = 'submenu' | 'navigation' | 'operation';
+const PROCESSOR_DIALOG_BASE_WIDTH = 1024;
+const PROCESSOR_DIALOG_BASE_HEIGHT = 720;
+const PROCESSOR_DIALOG_MARGIN = 8;
+const PROCESSOR_DIALOG_FIT_TARGET_ATTRIBUTE = 'data-cerebro-processor-dialog-fit-target';
+const PROCESSOR_DIALOG_SCALED_ATTRIBUTE = 'data-cerebro-processor-dialog-scaled';
+const PROCESSOR_DIALOG_MESSAGE_TYPE = 'cerebro:nifi-processor-dialog';
+
+function notifyProcessorDialogOpen(open: boolean): void {
+    try {
+        window.parent?.postMessage(
+            {
+                type: PROCESSOR_DIALOG_MESSAGE_TYPE,
+                open
+            },
+            '*'
+        );
+    } catch {
+        // 부모 창 접근이 막힌 환경에서는 NiFi 내부 크기만 맞춘다.
+    }
+}
+
+function resetProcessorDialogPane(pane: Element): void {
+    pane.removeAttribute(PROCESSOR_DIALOG_FIT_TARGET_ATTRIBUTE);
+    if (!(pane instanceof HTMLElement)) {
+        return;
+    }
+    [
+        'position',
+        'inset',
+        'left',
+        'top',
+        'width',
+        'max-width',
+        'height',
+        'max-height',
+        'margin',
+        'transform',
+        'transform-origin'
+    ].forEach((property) => pane.style.removeProperty(property));
+}
+
+function processorDialogText(element: Element): string {
+    return (element.textContent ?? '').replace(/\s+/g, ' ').trim();
+}
+
+function isProcessorEditDialog(element: Element): boolean {
+    const text = processorDialogText(element);
+    return (
+        Boolean(element.querySelector('.processor-configuration'))
+        || (/(Edit\s+Processor|프로세서\s*편집|Processor\s*\|)/i.test(text) && /\bApply\b|적용/.test(text))
+    );
+}
+
+function findProcessorDialogPane(): HTMLElement | null {
+    const panes = Array.from(document.querySelectorAll<HTMLElement>('.cdk-overlay-pane'));
+    return panes.find(isProcessorEditDialog) ?? null;
+}
+
+function processorDialogViewport(): { width: number; height: number; left: number; top: number } {
+    const fallback = {
+        width: window.innerWidth,
+        height: window.innerHeight,
+        left: PROCESSOR_DIALOG_MARGIN,
+        top: PROCESSOR_DIALOG_MARGIN
+    };
+
+    try {
+        const frame = window.frameElement;
+        if (!(frame instanceof HTMLElement) || !window.parent) {
+            return fallback;
+        }
+
+        const rect = frame.getBoundingClientRect();
+        const parentWidth = window.parent.visualViewport?.width ?? window.parent.innerWidth;
+        const parentHeight = window.parent.visualViewport?.height ?? window.parent.innerHeight;
+        const visibleLeft = Math.max(rect.left, 0);
+        const visibleTop = Math.max(rect.top, 0);
+        const visibleRight = Math.min(rect.right, parentWidth);
+        const visibleBottom = Math.min(rect.bottom, parentHeight);
+        const visibleWidth = Math.max(1, visibleRight - visibleLeft);
+        const visibleHeight = Math.max(1, visibleBottom - visibleTop);
+
+        return {
+            width: Math.min(window.innerWidth, visibleWidth),
+            height: Math.min(window.innerHeight, visibleHeight),
+            left: Math.max(PROCESSOR_DIALOG_MARGIN, visibleLeft - rect.left + PROCESSOR_DIALOG_MARGIN),
+            top: Math.max(PROCESSOR_DIALOG_MARGIN, visibleTop - rect.top + PROCESSOR_DIALOG_MARGIN)
+        };
+    } catch {
+        return fallback;
+    }
+}
+
+function fitProcessorDialog(): void {
+    const root = document.documentElement;
+    const pane = findProcessorDialogPane();
+    document
+        .querySelectorAll(`[${PROCESSOR_DIALOG_FIT_TARGET_ATTRIBUTE}='true']`)
+        .forEach((element) => {
+            if (element !== pane) {
+                resetProcessorDialogPane(element);
+            }
+        });
+
+    if (!pane) {
+        root.removeAttribute(PROCESSOR_DIALOG_SCALED_ATTRIBUTE);
+        notifyProcessorDialogOpen(false);
+        return;
+    }
+
+    notifyProcessorDialogOpen(true);
+    const viewport = processorDialogViewport();
+    const availableWidth = Math.max(1, viewport.width - PROCESSOR_DIALOG_MARGIN * 2);
+    const availableHeight = Math.max(1, viewport.height - PROCESSOR_DIALOG_MARGIN * 2);
+    const scale = Math.max(
+        0.3,
+        Math.min(1, availableWidth / PROCESSOR_DIALOG_BASE_WIDTH, availableHeight / PROCESSOR_DIALOG_BASE_HEIGHT)
+    );
+    const scaledHeight = Math.max(PROCESSOR_DIALOG_BASE_HEIGHT, availableHeight / scale);
+
+    pane.setAttribute(PROCESSOR_DIALOG_FIT_TARGET_ATTRIBUTE, 'true');
+    if (scale >= 0.999) {
+        root.removeAttribute(PROCESSOR_DIALOG_SCALED_ATTRIBUTE);
+        resetProcessorDialogPane(pane);
+        pane.setAttribute(PROCESSOR_DIALOG_FIT_TARGET_ATTRIBUTE, 'true');
+        return;
+    }
+
+    root.setAttribute(PROCESSOR_DIALOG_SCALED_ATTRIBUTE, 'true');
+    root.style.setProperty('--cerebro-processor-dialog-scale', scale.toFixed(4));
+    root.style.setProperty('--cerebro-processor-dialog-width', `${PROCESSOR_DIALOG_BASE_WIDTH}px`);
+    root.style.setProperty('--cerebro-processor-dialog-height', `${scaledHeight}px`);
+    root.style.setProperty('--cerebro-processor-dialog-left', `${viewport.left}px`);
+    root.style.setProperty('--cerebro-processor-dialog-top', `${viewport.top}px`);
+
+    pane.style.setProperty('position', 'fixed', 'important');
+    pane.style.setProperty('inset', 'auto', 'important');
+    pane.style.setProperty('left', `${viewport.left}px`, 'important');
+    pane.style.setProperty('top', `${viewport.top}px`, 'important');
+    pane.style.setProperty('width', `${PROCESSOR_DIALOG_BASE_WIDTH}px`, 'important');
+    pane.style.setProperty('max-width', 'none', 'important');
+    pane.style.setProperty('height', `${scaledHeight}px`, 'important');
+    pane.style.setProperty('max-height', 'none', 'important');
+    pane.style.setProperty('margin', '0', 'important');
+    pane.style.setProperty('transform', `scale(${scale.toFixed(4)})`, 'important');
+    pane.style.setProperty('transform-origin', 'top left', 'important');
+}
+
+function installProcessorDialogFit(): void {
+    let frameId: number | null = null;
+    const schedule = (): void => {
+        if (frameId !== null) {
+            return;
+        }
+        frameId = window.requestAnimationFrame(() => {
+            frameId = null;
+            fitProcessorDialog();
+        });
+    };
+
+    const observer = new MutationObserver(schedule);
+    observer.observe(document.documentElement, { childList: true, subtree: true });
+    const frameResizeObserver = window.ResizeObserver && window.frameElement instanceof HTMLElement
+        ? new ResizeObserver(schedule)
+        : null;
+    if (window.frameElement instanceof HTMLElement) {
+        frameResizeObserver?.observe(window.frameElement);
+    }
+    window.addEventListener('resize', schedule);
+    window.visualViewport?.addEventListener('resize', schedule);
+    try {
+        window.parent?.addEventListener('resize', schedule);
+        window.parent?.visualViewport?.addEventListener('resize', schedule);
+    } catch {
+        // 부모 창 접근이 막힌 환경에서는 iframe 내부 크기만 기준으로 맞춘다.
+    }
+    schedule();
+}
+
+function installRecentPanelToggle(): void {
+    const root = document.documentElement;
+    root.classList.add('cerebro-submenu-open');
+    root.dataset['cerebroRecentPanel'] = 'submenu';
+
+    const clickExpansion = (panel: RecentPanel): void => {
+        const controlSelector = panel === 'navigation' ? '.navigation-control' : '.operation-control';
+        const expansionSelector = panel === 'navigation'
+            ? '.navigation-control .navigation-control-expansion'
+            : '.operation-control .operation-control-expansion';
+        const expansion = document.querySelector(expansionSelector) as HTMLElement | null;
+        const control = document.querySelector(controlSelector) as HTMLElement | null;
+        (expansion ?? control)?.click();
+    };
+
+    const isOpen = (panel: RecentPanel): boolean => {
+        if (panel === 'submenu') {
+            return root.classList.contains('cerebro-submenu-open');
+        }
+        const control = document.querySelector(
+            panel === 'navigation' ? '.navigation-control' : '.operation-control'
+        );
+        return Boolean(control && !control.querySelector('.fa-plus-square-o'));
+    };
+
+    const setOpen = (panel: RecentPanel, open: boolean): void => {
+        if (panel === 'submenu') {
+            root.classList.toggle('cerebro-submenu-open', open);
+        } else if (isOpen(panel) !== open) {
+            clickExpansion(panel);
+        }
+        if (open) {
+            root.dataset['cerebroRecentPanel'] = panel;
+        }
+    };
+
+    const installButton = (): void => {
+        if (document.querySelector('.cerebro-recent-panel-toggle')) {
+            return;
+        }
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.className = 'cerebro-recent-panel-toggle';
+        button.title = '최근에 연 패널 열기/닫기';
+        button.setAttribute('aria-label', '최근에 연 패널 열기/닫기');
+        button.addEventListener('click', (event) => {
+            const recent = (root.dataset['cerebroRecentPanel'] as RecentPanel | undefined) ?? 'submenu';
+            setOpen(recent, !isOpen(recent));
+            event.preventDefault();
+            event.stopPropagation();
+        });
+        document.body.appendChild(button);
+    };
+
+    document.addEventListener('click', (event) => {
+        const target = event.target instanceof Element ? event.target : null;
+        if (target?.closest('fd-header header.nifi-header')) {
+            root.dataset['cerebroRecentPanel'] = 'submenu';
+            if (!root.classList.contains('cerebro-submenu-open')) {
+                root.classList.add('cerebro-submenu-open');
+                event.preventDefault();
+                event.stopPropagation();
+            }
+        } else if (target?.closest('.navigation-control')) {
+            root.dataset['cerebroRecentPanel'] = 'navigation';
+        } else if (target?.closest('.operation-control')) {
+            root.dataset['cerebroRecentPanel'] = 'operation';
+        }
+    }, true);
+
+    if (document.body) {
+        installButton();
+    } else {
+        document.addEventListener('DOMContentLoaded', installButton, { once: true });
+    }
+}
+
+export function initCerebroUi(): void {
+    const root = document.documentElement;
+    root.setAttribute('data-cerebro-nifi-ui', '1');
+    if (isEmbeddedInCerebro()) {
+        root.classList.add('cerebro-embedded');
+        installRecentPanelToggle();
+        installProcessorDialogFit();
+    }
+    startCerebroKoreanText();
+}
