+const PROCESSOR_EDIT_TAB_SELECTOR = '[role="tab"], .mat-mdc-tab, .mat-tab-label';
+
+const SORTABLE: Array<[RegExp, string]> = [
+    [/^Name\s*([↑↓])?$/, '이름'],
+    [/^Provider\s*([↑↓])?$/, '제공자'],
+    [/^Description\s*([↑↓])?$/, '설명'],
