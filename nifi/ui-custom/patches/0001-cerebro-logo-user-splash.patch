index 0000000000000000000000000000000000000000..ea2fd8c8e1feb0b9658f04e8f3d0351aa5278bf3
--- /dev/null
+++ b/nifi-frontend/src/main/frontend/apps/nifi/src/app/cerebro/cerebro-embed.ts
@@ -0,0 +1,15 @@
+/*
+ * Cerebro 맞춤 (Cerebro 저장소 nifi/ui-custom/patches 로 관리한다 - NiFi 원본 소스에는 없는 파일).
+ *
+ * Cerebro «ETL 관리» 화면은 NiFi 를 iframe 으로 띄운다. 기능을 줄이는 변경(도구 숨김, 사용자 이름 · 로그아웃 숨김)은
+ * 그 안에서 열렸을 때만 적용한다 - NiFi 에 직접 들어온 관리자는 원래 기능(깔때기 · 포트 등)을 그대로 써야 한다.
+ * 모양만 바꾸는 변경(한글 · 색 · 글꼴)은 어디서 열든 적용한다.
+ */
+export function isEmbeddedInCerebro(): boolean {
+    try {
+        return window.self !== window.top;
+    } catch {
+        // 다른 출처의 부모가 접근을 막으면 예외가 난다 - 그 자체가 iframe 안이라는 뜻이다.
+        return true;
+    }
+}
