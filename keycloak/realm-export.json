{
  "realm": "cerebro",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self' https://localhost:13001; object-src 'none';",
    "xFrameOptions": ""
  },
  "roles": {
    "realm": [
      { "name": "portal_admin", "description": "통합 웹 포털 관리자" },
      { "name": "portal_user", "description": "통합 웹 포털 일반 사용자" }
    ]
  },
  "clients": [
    {
      "clientId": "cerebro-portal",
      "name": "Cerebro ETL Portal (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost:13001/*",
        "http://localhost:13001/*",
        "https://host.docker.internal:13001/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:13001/*##http://localhost:13001/*"
      }
    },
    {
      "clientId": "nifi",
      "name": "Apache NiFi",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_NIFI_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://localhost:18443/*",
        "https://host.docker.internal:18443/*",
        "https://localhost:13001/*"
      ],
      "webOrigins": ["+"]
    },
    {
      "clientId": "airflow",
      "name": "Apache Airflow",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_AIRFLOW_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/*",
        "http://host.docker.internal:8090/*",
        "https://localhost:13001/airflow/*"
      ],
      "webOrigins": ["+"]
    }
  ],
  "users": [
    {
      "username": "${KEYCLOAK_SEED_USER_ID}",
      "enabled": true,
      "emailVerified": true,
      "email": "cerebro-admin@example.com",
      "firstName": "Cerebro",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SEED_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["portal_admin", "portal_user"]
    }
  ]
}
