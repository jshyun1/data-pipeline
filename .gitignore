# 환경 변수 (비밀번호 포함) - 절대 커밋 금지
.env
.env.*
!.env.example

# Docker / Compose 로컬 상태
*.log
# 비정형 파이프라인 검증용 샘플은 예외 (로그 파싱 경로를 테스트하려면 있어야 함)
!nifi/samples/unstructured/*.log
.DS_Store

# NiFi / Kafka Connect 로컬 산출물
nifi/drivers/
kafka-connect/plugins/

# IDE
.idea/
.vscode/
*.iml

# SDKMAN / JDK 로컬 설치물
.sdkman/

# web/backend (Gradle) 빌드 산출물 - gradlew/gradle-wrapper.jar는 커밋 대상이라 제외하지 않음
web/backend/build/
web/backend/.gradle/
web/backend/out/
web/backend/bin/

# web/cerebroetl-ui (Node) 빌드 산출물
web/cerebroetl-ui/node_modules/
web/cerebroetl-ui/dist/

# 로그 파이프라인 검증용 테스트 로그 파일 (디렉터리 자체는 .gitkeep으로 유지)
log-sources/*
!log-sources/.gitkeep

# offline/save-images.sh 결과물 (이미지 tar, 수 GB) - 커밋 대상 아님
release/

# Airflow 컨테이너가 쓰는 로그/DB 런타임 산출물 (dags/plugins는 커밋 대상)
airflow/logs/*
!airflow/logs/.gitkeep
__pycache__/
*.pyc

# NiFi가 파일 감시/적재용으로 bind-mount해서 실제 쓰는 런타임 데이터 폴더 -
# 배포 서버마다 내용이 다르고(컨테이너 사용자 권한으로 파일이 생성됨) 코드가 아니므로
# 커밋/배포 동기화 대상에서 제외한다.
logfile/**
!logfile/**/
!logfile/**/.gitkeep
csv_data/**
!csv_data/**/
!csv_data/**/.gitkeep
