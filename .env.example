# =========================================================================
# 이 파일을 .env 로 복사해서 사용하세요: cp .env.example .env
# .env 는 git에 커밋되지 않습니다 (.gitignore 참고).
#
# CDC 소스/타겟 DB 연결정보는 더 이상 여기서 관리하지 않습니다 - Cerebro ETL
# 웹의 "연결정보" 화면에서 등록/수정합니다. 여기 남은 TARGET_DB_*는 metadata-db와
# 별개로 로컬 POC용 타깃 DB 컨테이너 자체를 띄우기 위한 값입니다.
# 로컬 POC 단계 : docker compose --profile poc up -d  -> target-db 컨테이너가 뜹니다.
# =========================================================================

COMPOSE_PROJECT_NAME=data-pipeline

# 자체 빌드 이미지(kafka-connect/nifi/pipeline-api/pipeline-ui/cerebroetl-ui) 태그.
# docs/kafka-webservice-design.md §13.7: "이미지 태그는 latest 금지" - 폐쇄망 반입용
# 이미지를 빌드/저장할 때는 반드시 이 값을 릴리스 버전으로 바꿔서 빌드하세요
# (예: APP_VERSION=1.0.0 docker compose build). 로컬 개발 중에는 기본값(latest)이면 충분합니다.
APP_VERSION=latest

# ----- Target DB ("타란툴라DB" 스탠드인 = PostgreSQL 호환) -----
# 실제 사내 타란툴라DB(PostgreSQL 기반)로 교체 시 IMAGE/HOST/PORT/계정만 바꾸면 됩니다.
TARGET_DB_IMAGE=postgres:16-alpine
TARGET_DB_HOST=target-db
# 호스트에 이미 5432를 쓰는 프로세스가 있다면 이 값만 바꾸세요
# (컨테이너 내부 포트는 여전히 5432 - target-db:5432 내부 통신엔 영향 없음)
TARGET_DB_PORT=15432
TARGET_DB_NAME=tarantula
TARGET_DB_USER=tarantula_app
TARGET_DB_PASSWORD=ChangeMe_Target_2026!

# ----- Kafka (KRaft 모드, 브로커 1대) -----
KAFKA_IMAGE=apache/kafka:3.8.0
# 호스트에 이미 9092를 쓰는 프로세스가 있다면 이 값만 바꾸세요
# (브로커의 내부 리스너/ADVERTISED_LISTENERS는 항상 kafka:9092 고정이라 무관함)
KAFKA_BROKER_PORT=19092
# 최초 1회만 사용되는 클러스터 ID (base64, 22자). 필요시 재발급 가능:
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(16)).decode().rstrip('='))"
KAFKA_CLUSTER_ID=p2L8jgNR4wDo_-ShniX13A
# 저사양 PC(4코어/16GB급) 대응: 브로커 1대짜리 POC라 큰 힙이 필요 없음
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# ----- Kafka Connect (Debezium Oracle LogMiner 커넥터) -----
# REST API는 인증이 없어서 호스트에 노출하지 않는다 - docker 네트워크 안에서
# kafka-connect:8083으로만 접근 가능(pipeline-api 등).
CONNECT_GROUP_ID=oracle-cdc-connect-cluster
CONNECT_IMAGE_TAG=7.7.1
DEBEZIUM_VERSION=3.6.0
OJDBC_VERSION=23.26.2.0.0
CONNECT_HEAP_OPTS=-Xms256m -Xmx768m
# CDC 메시지 압축(zstd/lz4/snappy/gzip/none). 스키마 블록이 메시지마다 반복돼 압축률이
# 매우 높다 - 비워두면 zstd. CPU가 빠듯하면 lz4로 낮출 것.
CONNECT_COMPRESSION_TYPE=zstd

# ----- NiFi (JDK 21 필수: NiFi 2.x부터 Java 21 요구) -----
# NiFi 2.x 공식 이미지는 HTTP를 지원하지 않고 HTTPS + 단일 사용자 인증으로만 기동됨
# -> 외부 접속은 https://localhost:${NIFI_PUBLIC_HTTPS_PORT}/nifi 로 접속
#    기본값은 컨테이너 내부 HTTPS 포트와 같은 8443
NIFI_IMAGE_TAG=2.2.0
# 컨테이너 내부 HTTPS 리스닝 포트(NIFI_WEB_HTTPS_PORT로 그대로 전달됨) - 바꾸지 말 것.
# 호스트에 노출되는 포트는 아래 NIFI_PUBLIC_HTTPS_PORT가 따로 담당한다 - 호스트에
# 이미 8443을 쓰는 프로세스가 있다면 그 값만 바꾸면 됨.
NIFI_HTTPS_PORT=8443
NIFI_PUBLIC_HTTPS_PORT=18443
NIFI_SINGLE_USER_USERNAME=admin
NIFI_SINGLE_USER_PASSWORD=ChangeMe_Nifi_2026!
NIFI_JVM_HEAP_INIT=512m
NIFI_JVM_HEAP_MAX=1g
# 비정형 데이터 수집용 ListenHTTP 프로세서 포트 (unstructured_landing.file_objects 적재 플로우).
# NiFi 플로우 캔버스 안에 프로세서 설정값으로 직접 박혀있는 숫자라(env로 재설정 안 됨)
# 바꾸면 안 됨 - 호스트 노출 포트는 아래 NIFI_LISTENHTTP_PUBLIC_PORT가 담당한다.
NIFI_LISTENHTTP_PORT=8442
NIFI_LISTENHTTP_PUBLIC_PORT=18442
# "비정형" 프로세스그룹의 ListenHTTP-unstructured 포트. 이미지/동영상/로그/XML/CSV를
# 한 엔드포인트(POST /unstructured)로 받아서 Content-Type 기준으로 종류별 서브그룹에
# 나눠 보낸다. 위와 같은 이유로 컨테이너 내부 포트는 캔버스에 박혀있어 바꾸면 안 된다.
# 이 두 줄이 없어도 compose가 기본값(18444:8444)으로 뜬다 - 포트를 바꿀 때만 필요하다.
NIFI_UNSTRUCTURED_HTTP_PORT=8444
NIFI_UNSTRUCTURED_HTTP_PUBLIC_PORT=18444
# NiFi는 HTTPS 요청의 Host 헤더를 자체 검증하므로, 실제 접속에 쓰는 호스트명/IP:포트를
# (NIFI_HTTPS_PORT가 아니라 호스트에 노출되는 NIFI_PUBLIC_HTTPS_PORT 기준으로) 콤마로
# 추가해야 함 (예: 192.168.0.23:18443). 서버 IP/도메인은 환경마다 다르므로 배포할 때마다
# 이 값에 실제 접속 주소를 반드시 추가하세요. localhost:13001/127.0.0.1:13001은 통합 포털
# (cerebroetl-ui)에서 iframe으로 열 때 필요. nifi:8443(도커 네트워크 내부 서비스명, 내부
# 포트 그대로)도 포함해야 함 - 안 넣으면 같은 네트워크의 다른 컨테이너(Airflow 등)가
# https://nifi:8443으로 호출할 때 "Invalid SNI"로 거부됨.
NIFI_WEB_PROXY_HOST=localhost:18443,127.0.0.1:18443,localhost:13001,127.0.0.1:13001,nifi:8443
POSTGRES_JDBC_VERSION=42.7.4

# ----- Metadata DB (Kafka 파이프라인 웹서비스 전용, target-db와 별개 인스턴스) -----
# docs/kafka-webservice-design.md §14 참고. target-db(CDC 타겟)와는 운영 주기가
# 달라서 별도 컨테이너로 분리함 (target-db 재사용 안 함).
METADATA_DB_HOST=metadata-db
# 호스트에 이미 5434를 쓰는 프로세스가 있다면 이 값만 바꾸세요
# (컨테이너 내부 포트는 여전히 5432 - metadata-db:5432 내부 통신엔 영향 없음)
METADATA_DB_PORT=15434
METADATA_DB_NAME=pipeline_meta
METADATA_DB_USER=pipeline_app
METADATA_DB_PASSWORD=ChangeMe_Meta_2026!

# ----- Pipeline API (web/backend, Spring Boot) -----
# 컨테이너 내부 포트(SERVER_PORT로 그대로 전달됨, nginx.conf/vite.config.ts가
# pipeline-api:8081을 그대로 참조하므로 바꾸지 말 것) - 호스트에 노출되는 포트는
# 아래 PIPELINE_API_PUBLIC_PORT가 따로 담당한다. 호스트에 이미 8081을 쓰는
# 프로세스가 있다면 그 값만 바꾸면 됨.
PIPELINE_API_PORT=8081
PIPELINE_API_PUBLIC_PORT=18086
# pipeline_connection.encrypted_password 암복호화 키. 반드시 각자 새로 발급할 것
# (openssl rand -hex 32 / openssl rand -hex 16) - 기본값 없으면 앱이 부팅을 거부함.
PIPELINE_CRYPTO_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PIPELINE_CRYPTO_SALT=0123456789abcdef0123456789abcdef

# cerebroetl-ui 자체 로그인(계정테이블 기반) JWT 서명 키. openssl rand -hex 32
PIPELINE_JWT_SECRET=ChangeMe_GenerateWith_openssl_rand_hex_32

# 통합 계정 테이블(ST_USER) - 실제 회사 전체 사용자 디렉터리(MySQL). 여러 시스템이 공유하므로
# 여기서는 조회(로그인 검증)만 하고 절대 쓰기(INSERT/UPDATE/DELETE)하지 않는다.
ACCOUNT_DB_HOST=192.168.50.30
ACCOUNT_DB_PORT=3306
ACCOUNT_DB_NAME=mydb
ACCOUNT_DB_USER=ChangeMe_AccountDbUser
ACCOUNT_DB_PASSWORD=ChangeMe_AccountDbPassword

# ----- Pipeline UI (web/frontend, React+Vite, nginx로 정적 서빙) -----
PIPELINE_UI_PORT=13000

# ----- Cerebro ETL UI (통합 콘솔, web/cerebroetl-ui) -----
CEREBROETL_UI_PORT=13001

# ----- Filebeat (로그파일 실시간 적재 파이프라인의 소스, docs/kafka-webservice-design.md §12) -----
FILEBEAT_IMAGE_TAG=8.15.3

# ----- Airflow (통합 "Dataworld ETL" 웹의 선행 작업 - Kafka/NiFi 파이프라인 실행/중지/재시작을
# DAG가 담당하게 될 예정. 메타데이터 DB는 별도 컨테이너 대신 metadata-db(Postgres 인스턴스)
# 안의 database 하나로 둔다. 전용 계정을 쓰는 이유는 아래 참고) -----
# 바인드 마운트된 ./airflow/logs에 컨테이너가 쓰려면 호스트 UID와 맞아야 함: id -u 결과를 넣을 것
AIRFLOW_UID=1000
# 3.1부터 한국어 UI 공식 지원 (17개 언어 i18n)
AIRFLOW_IMAGE_TAG=3.2.2
AIRFLOW_DB_NAME=airflow
# METADATA_DB_USER/PASSWORD를 재사용하지 않고 전용 계정을 쓴다: SQL_ALCHEMY_CONN은
# JSON 형식(AIRFLOW_CONN_* 처럼)을 못 쓰고 URL 문자열 하나뿐이라, 비밀번호에 URL
# 예약문자(!@#: 등)가 있으면 파싱이 깨진다 - 이 비밀번호는 반드시 그런 문자를 피할 것.
AIRFLOW_DB_USER=airflow_app
AIRFLOW_DB_PASSWORD=ChangeMe_Airflow_2026!
AIRFLOW_WEBSERVER_PORT=8090
# 통합 포털(cerebroetl-ui) 리버스 프록시 경로 기준 Airflow API 베이스 URL.
# 브라우저가 실제 접속하는 호스트명/IP와 달라지면 로그인이 "Invalid or unsafe next URL"로
# 거부되므로, localhost가 아닌 주소로 배포할 땐 이 값을 그 주소로 바꿀 것.
AIRFLOW_PUBLIC_BASE_URL=http://localhost:13001/airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=ChangeMe_AirflowAdmin_2026!
# Fernet key(커넥션/변수 암호화용, 기본값 없음): 아래 명령으로 새로 발급할 것
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=ChangeMe_GenerateWith_Fernet_generate_key
# 웹서버 세션 암호화 키(기본값 없음): openssl rand -hex 32
AIRFLOW_WEBSERVER_SECRET_KEY=ChangeMe_GenerateWith_openssl_rand_hex_32
# 3.x Task Execution API(AIP-72) 컴포넌트 간 인증용 JWT 서명 키(기본값 없음): openssl rand -hex 32
AIRFLOW_JWT_SECRET=ChangeMe_GenerateWith_openssl_rand_hex_32
# ----- Oracle CDC(Debezium LogMiner) -----
# true면 온라인 redo를 읽지 않고 아카이브 로그만 읽는다. 운영 DB가 온라인 redo 접근을
# 막는 경우에만 켤 것 - 변경이 아카이브로 넘어간 뒤에야 읽히므로 지연이 redo 스위치
# 주기만큼 늘어나고, 아직 안 읽은 아카이브가 삭제되면 그 구간은 전체 재적재로만 복구된다.
# 켤 때는 Oracle 쪽 ARCHIVE_LAG_TARGET(강제 스위치 주기)과 아카이브 보존 기간을 같이 정할 것.
ORACLE_ARCHIVE_LOG_ONLY=false
# LogMiner가 접속할 CDB 이름. XE는 항상 XE고, 다른 에디션은 설치 시 정한 이름을 넣는다.
ORACLE_CDB_NAME=XE

# pipeline-api가 대시보드 인프라 구역에서 Airflow 스케줄러/DAG 프로세서 생존을 확인할
# 주소(컨테이너 네트워크 내부용, 브라우저 접속 주소와 무관). 비워두면 이 기본값을 쓴다.
AIRFLOW_BASE_URL=http://airflow-apiserver:8080

# NiFi keystore/truststore 비밀번호(최초엔 컨테이너가 자동생성한 값,
# docker exec nifi grep nifi.security.keystorePasswd conf/nifi.properties 로 확인)
NIFI_KEYSTORE_PASSWORD=ChangeMe_from_generated_keystore
NIFI_TRUSTSTORE_PASSWORD=ChangeMe_from_generated_truststore
